# Variables para docker-compose.yml. Copia este archivo a ".env" (en la raíz,
# junto a docker-compose.yml) y cambia las claves para un uso real; docker
# compose lo carga solo. Sin este archivo, docker-compose.yml usa valores por
# defecto válidos solo para probar en local.

POSTGRES_PASSWORD=cambia-esta-clave-de-administrador
PGPASSWORD=cambia-esta-clave-de-la-api
PGDATABASE=pmbok8
PGUSER=pmbok8_app

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=

JWT_EXPIRA_HORAS=12

ADMIN_CORREO=admin@pmbok.local
ADMIN_CLAVE=cambia-esta-clave

REGISTRO_ABIERTO=true
REGISTRO_ROL=director

PORT=3000
