# Configuración local del backend. No se sube a repositorios (ver .gitignore).
PORT=3000

# PostgreSQL · cuenta de la API, con permisos solo sobre los datos.
# El migrador crea este rol (o sincroniza su contraseña) al arrancar.
PGHOST=localhost
PGPORT=5432
PGUSER=pmbok8_app
PGPASSWORD=cambia-esta-clave-larga
PGDATABASE=pmbok8

# PostgreSQL · cuenta administradora: crea la base y el rol y aplica migraciones.
# Si la contraseña lleva espacios, entre comillas.
PGADMIN_USER=postgres
PGADMIN_PASSWORD="clave-del-superusuario"

# Sesiones
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRA_HORAS=12

# Cuenta inicial (solo se crea si no hay ningún administrador)
ADMIN_CORREO=admin@pmbok.local
ADMIN_CLAVE=admin123

# Opcionales
# HOST=127.0.0.1
# CORS_ORIGENES=http://localhost:3000,http://localhost:8000,null
# ARCHIVO_LIMITE_MB=10
# PGROOT (para scripts\postgres.cmd) se toma del entorno; por defecto %USERPROFILE%\pgsql
